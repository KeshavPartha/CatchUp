# Supabase Configuration (required for accounts and durable user progress)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App Configuration (used for deployment/auth URL setup)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only recap generation. Never prefix these with NEXT_PUBLIC_ or expose them to the client.
CATCHUP_RECAP_PROVIDER=openai
OPENAI_API_KEY=your_server_only_openai_api_key
OPENAI_MODEL=gpt-4o-mini
